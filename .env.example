# Python 3.12+ runtime, Node 24 for building the UI.
# Set ADMIN_USER and either ADMIN_PASSWORD or ADMIN_PASSWORD_HASH before running.
HOST=127.0.0.1
PORT=8787
ADMIN_USER=admin
ADMIN_PASSWORD=
# Preferred: generate interactively with PYTHONPATH=backend python -m aegis.password_hash
# Paste the generated scrypt hash inside single quotes to preserve $ in Compose.
# ADMIN_PASSWORD_HASH=''
PUBLIC_BASE_URL=http://localhost:8787
# Optional comma-separated exact hostnames, no scheme/path/port/wildcards.
# Omitted: use PUBLIC_BASE_URL hostname when configured.
# AEGIS_ALLOWED_HOSTS=localhost
AEGIS_DATABASE_PATH=data/aegis.sqlite

# Browser administrator sessions. Server enforces idle and absolute expiration.
# AEGIS_SESSION_IDLE_SECONDS=1800
# AEGIS_SESSION_MAX_SECONDS=43200
# Login attempts are shared through SQLite across Python processes/restarts.
# AEGIS_LOGIN_WINDOW_SECONDS=300
# AEGIS_LOGIN_ACCOUNT_LIMIT=10
# AEGIS_LOGIN_IP_LIMIT=20
# AEGIS_LOGIN_GLOBAL_LIMIT=100

# The Python service processes evaluation jobs even with no browser.
# Set false when running a separate Python evaluation worker.
AEGIS_EVALUATION_WORKER_ENABLED=true

# Optional remote runner. Set the same separate secret on server and runner.
# AEGIS_EVALUATION_WORKER_TOKEN=
# Runner-only settings. Never put these values into browser code or source.
# AEGIS_EVALUATION_SERVER_URL=https://your-console.example
# AEGIS_SITE_SERVICE_TOKEN=

# Explicitly permit private upstream destinations for self-hosted internal use.
# Target origins must still be registered under Access control.
# Internal vLLM supports HTTP, e.g. http://vllm.internal:8000/v1.
# Set true below to connect to private IPs or internal hostnames.
AEGIS_ALLOW_PRIVATE_UPSTREAM=false

# Connection.secretEnv references these names. Never paste values into the UI.
VLLM_MAIN_API_KEY=
VLLM_GUARD_API_KEY=

# Basic username or trusted proxy identity -> admin/editor/viewer.
# Unmapped users become viewers when a role map is configured.
# An empty or omitted map keeps the authenticated account as admin.
# AEGIS_ROLE_MAP={"admin":"admin"}
# Optional separate console administrator token, independent of the role map.
# Never reuse a Gateway key or the evaluation worker token.
# AEGIS_ADMIN_TOKEN=
# Proxy identity is disabled by default. Trust only a controlled proxy socket IP.
# AEGIS_TRUST_PROXY_IDENTITY=false
# Comma-separated exact socket IPs, not CIDRs or forwarded client addresses.
# AEGIS_TRUSTED_PROXY_IPS=
# Disable credentialless loopback development access. Basic/token auth still works.
# AEGIS_REQUIRE_ADMIN_IDENTITY=false

# Gateway와 검증이 함께 사용하는 모델 연결별 동시 호출 한도 (1~1000)
AEGIS_MODEL_MAX_CONCURRENT=8

# Total immutable policy revisions across all policies (100~1000). Referenced revisions are never removed.
# AEGIS_POLICY_MAX_VERSIONS=100
